# ARCEN Backend Environment Variables

# Server Port
PORT=5000

# Target Email Addresses for Form Submissions
# Primary email where candidate applications & contact messages will be sent
PRIMARY_EMAIL=recruitment@arcen.tech

# Backup fallback email (if primary email delivery encounters an error)
BACKUP_EMAIL=backup-recruitment@arcen.tech

# SMTP Server Configuration (Optional - for sending live emails via Gmail/SendGrid/Resend)
# For Gmail, set SMTP_HOST=smtp.gmail.com, SMTP_PORT=5857 or 465
# Generate an App Password in your Google Account: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
